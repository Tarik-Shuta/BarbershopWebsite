generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum UserRole {
  CUSTOMER
  BARBER
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String
  passwordHash String
  role         UserRole  @default(CUSTOMER)
  barberName   String?   @unique
  bookings     Booking[]
  createdAt    DateTime  @default(now())
}

model Booking {
  id        String        @id @default(cuid())
  name      String
  phone     String
  barber    String
  service   String
  startsAt  DateTime
  notes     String?
  status    BookingStatus @default(PENDING)
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())

  @@index([startsAt, status])
  @@index([barber, startsAt])
}
